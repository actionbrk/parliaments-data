{
  "tasks": {
    "validate": "deno run --allow-read=. --allow-env=GITHUB_ACTIONS,LOG_STREAM,LOG_TOKENS scripts/validate.ts",
    "build": "deno run --allow-read=. --allow-write=dist --allow-env=GITHUB_ACTIONS,GITHUB_SHA,GITHUB_SERVER_URL,GITHUB_REPOSITORY,LOG_STREAM,LOG_TOKENS scripts/build.ts",
    "fetch": "deno run --allow-read=. --allow-write=data --allow-net --allow-env=GITHUB_ACTIONS,LOG_STREAM,LOG_TOKENS scripts/fetch.ts",
    "test": "deno test --allow-read --allow-write --allow-env=LOG_STREAM,LOG_TOKENS,PATH --allow-run=git,bash scripts/",
    "check": "deno fmt --check && deno lint && deno check scripts/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/path": "jsr:@std/path@^1.1.2",
    "ajv": "npm:ajv@^8.20.0",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "yaml": "npm:yaml@^2.9.1"
  },
  "exclude": ["dist/"],
  "fmt": {
    "proseWrap": "preserve",
    "exclude": ["data/"]
  },
  "lock": {
    "frozen": true
  }
}
