{
  "tasks": {
    "validate": "deno run --allow-read=. --allow-env=GITHUB_ACTIONS,LOG_STREAM,LOG_TOKENS scripts/validate.ts",
    "test": "deno test --allow-read --allow-write --allow-env=LOG_STREAM,LOG_TOKENS scripts/",
    "check": "deno fmt --check && deno lint && deno check scripts/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/path": "jsr:@std/path@^1.1.2",
    "ajv": "npm:ajv@^8.20.0",
    "ajv-formats": "npm:ajv-formats@^3.0.1",
    "yaml": "npm:yaml@^2.9.1"
  },
  "fmt": {
    "proseWrap": "preserve",
    "exclude": ["data/"]
  },
  "lock": {
    "frozen": true
  }
}
